{
  "manifest_version": 3,
  "name": "TechLens — Website Technology Inspector",
  "version": "1.2.1",
  "description": "Inspect website technologies and correlate exact versions with OSV and NVD advisories.",
  "minimum_chrome_version": "123",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect technologies",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
